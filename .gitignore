# Secrets. serve.mjs reads SUPABASE_SERVICE_ROLE_KEY / PAYPAL_* / MONDAY_* out of
# a local .env, so one stray `git add` would publish them. Never track these.
.env
.env.*
!.env.example

# Client photo libraries — too large for Git and protected from public download
images/

# Unreferenced raw assets
hero-photo.jpg

# Local-only dev test tooling — seeds a fake Pro session + registers a
# Supabase-blocking service worker. Never ship to production.
social-app/dev-player.html
social-app/dev-emptyhype.html
social-app/dev-searchtest.html
social-app/dev-sw.js
